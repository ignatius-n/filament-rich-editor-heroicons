{
    "name": "oliwol/filament-rich-editor-heroicons",
    "description": "A seamless integration for Filament v4/v5 that allows users to insert Heroicons directly into the RichEditor (TipTap). Enhance your content by adding scalable vector icons with a dedicated picker button.",
    "keywords": [
        "oliwol",
        "laravel",
        "filament-rich-editor-heroicons",
        "heroicons",
        "rich-editor",
        "tiptap",
        "filament"
    ],
    "homepage": "https://github.com/oliwol/filament-rich-editor-heroicons",
    "support": {
        "issues": "https://github.com/oliwol/filament-rich-editor-heroicons/issues",
        "source": "https://github.com/oliwol/filament-rich-editor-heroicons"
    },
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "filament/filament": "^v4.0|^v5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "ueberdosis/tiptap-php": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Oliwol\\FilamentRichEditorHeroicons\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oliwol\\FilamentRichEditorHeroicons\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "lint": "./vendor/bin/pint",
        "refactor": "./vendor/bin/rector",
        "test:arch": "./vendor/bin/pest --filter=arch",
        "test:lint": "./vendor/bin/pint --test",
        "test:refactor": "./vendor/bin/rector --dry-run",
        "test:types": "phpstan analyse",
        "test:unit": "./vendor/bin/pest --colors=always",
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:arch",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Oliwol\\FilamentRichEditorHeroicons\\FilamentRichEditorHeroiconsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
